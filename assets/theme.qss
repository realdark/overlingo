/* =========================================================
   SCREEN TRANSLATOR - UNIFIED DARK THEME

   Note: there is deliberately NO global "QWidget { background: ... }"
   rule - MainWindow, OverlayPanel and SecondaryOverlay rely on
   WA_TranslucentBackground + their own paintEvent for the translucent
   rounded background; a global background here would break it. Everything
   below is scoped to specific classes/names so it doesn't touch those.
   ========================================================= */

/* --- Dialogs (Settings, About, warnings) --- */
QDialog {
    background-color: #1e1e1e;
}
QDialog QLabel {
    color: #e5e7eb;
    font-size: 13px;
}

/* --- Tabs in the Settings dialog --- */
QDialog QTabWidget::pane {
    border: 1px solid rgba(90, 90, 90, 150);
    border-radius: 6px;
    background-color: #1e1e1e;
    top: -1px;
}
QDialog QTabBar::tab {
    background-color: #2a2a2a;
    color: #e5e7eb;
    padding: 6px 14px;
    border: 1px solid rgba(90, 90, 90, 150);
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}
QDialog QTabBar::tab:selected {
    background-color: #3b82f6;
    color: white;
}
QDialog QTabBar::tab:hover:!selected {
    background-color: #35363a;
}

/* --- Input fields in dialogs --- */
QDialog QLineEdit,
QDialog QSpinBox,
QDialog QComboBox {
    background-color: #2a2a2a;
    color: #e5e7eb;
    border: 1px solid rgba(90, 90, 90, 150);
    border-radius: 5px;
    padding: 4px 8px;
    selection-background-color: #3b82f6;
}
QDialog QComboBox::drop-down {
    border: none;
    width: 20px;
}
QDialog QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #e5e7eb;
    selection-background-color: #3b82f6;
    border: 1px solid rgba(90, 90, 90, 150);
}

/* Read-only/disabled fields - without this they look identical
   to active ones, because the hard-coded colors above override
   Qt's standard "greyed out" look. */
QDialog QLineEdit:disabled,
QDialog QSpinBox:disabled,
QDialog QComboBox:disabled {
    background-color: rgba(42, 42, 42, 120);
    color: rgba(229, 231, 235, 90);
    border: 1px solid rgba(90, 90, 90, 70);
}

/* --- Checkboxes --- */
QDialog QCheckBox {
    color: #e5e7eb;
    spacing: 8px;
}
QDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid rgba(150, 150, 150, 180);
    background-color: #2a2a2a;
}
QDialog QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}
QDialog QCheckBox:disabled {
    color: rgba(229, 231, 235, 90);
}
QDialog QCheckBox::indicator:disabled {
    background-color: rgba(42, 42, 42, 80);
    border: 1px solid rgba(150, 150, 150, 70);
}

/* --- Slider (overlay opacity) --- */
QDialog QSlider::groove:horizontal {
    height: 4px;
    background: rgba(90, 90, 90, 150);
    border-radius: 2px;
}
QDialog QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #3b82f6;
    border-radius: 7px;
}
QDialog QSlider::handle:horizontal:hover {
    background: #60a5fa;
}

/* --- Main toolbar buttons ("Select & Translate", "Clear") ---
   The buttons have a fixed pixel width (see setup_buttons() in
   main_window.py) - padding and font-size are deliberately small so
   even the longest label fits without being clipped. */
QPushButton#primary_btn,
QPushButton#secondary_btn {
    color: white;
    border: none;
    border-radius: 6px;
    padding: 2px 4px;
    font-weight: 600;
    font-size: 12px;
}
QPushButton#primary_btn {
    background-color: rgba(59, 130, 246, 210);
}
QPushButton#primary_btn:hover {
    background-color: rgba(59, 130, 246, 255);
}
QPushButton#primary_btn:pressed {
    background-color: rgba(37, 99, 235, 255);
}

QPushButton#secondary_btn {
    background-color: rgba(75, 85, 99, 200);
}
QPushButton#secondary_btn:hover {
    background-color: rgba(107, 114, 128, 230);
}
QPushButton#secondary_btn:pressed {
    background-color: rgba(55, 65, 81, 255);
}
QPushButton#secondary_btn:disabled {
    background-color: rgba(75, 85, 99, 90);
    color: rgba(255, 255, 255, 110);
}

/* --- Dialog buttons (e.g. "Save" in Settings, "OK" in About) --- */
QDialog QPushButton {
    background-color: rgba(59, 130, 246, 210);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 13px;
}
QDialog QPushButton:hover {
    background-color: rgba(59, 130, 246, 255);
}
QDialog QPushButton:pressed {
    background-color: rgba(37, 99, 235, 255);
}
QDialog QPushButton:disabled {
    background-color: rgba(59, 130, 246, 70);
    color: rgba(255, 255, 255, 110);
}

/* --- Icon buttons (exit, settings, info, move, eye) --- */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 15px;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 35);
}
QToolButton:pressed {
    background-color: rgba(255, 255, 255, 60);
}

/* --- The Play button visually belongs to the left-hand row
   ("Select & Translate", "Clear"), not to the system icons on the right -
   so it takes the same grey style as "Clear" instead of the bare
   round hover icon above. The ID selector is more specific than the
   bare "QToolButton" above, so it fully overrides it. --- */
QToolButton#secondary_icon_btn {
    background-color: rgba(75, 85, 99, 200);
    border: none;
    border-radius: 6px;
}
QToolButton#secondary_icon_btn:hover {
    background-color: rgba(107, 114, 128, 230);
}
QToolButton#secondary_icon_btn:pressed {
    background-color: rgba(55, 65, 81, 255);
}

/* --- 3.0: "Translate again" is grey until an area has been selected --- */
QToolButton#secondary_icon_btn:disabled {
    background-color: rgba(75, 85, 99, 90);
}

/* --- 3.0: the "?" button opens a menu (Help / About) - without
   the arrow Qt adds by default to buttons with a menu. --- */
QToolButton#menu_icon_btn::menu-indicator {
    image: none;
    width: 0px;
}
QMenu {
    background-color: #2a2a2a;
    color: #e5e7eb;
    border: 1px solid rgba(90, 90, 90, 150);
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #3b82f6;
    color: white;
}

/* --- 3.0: history and text translation --- */
QDialog QPlainTextEdit,
QDialog QListWidget {
    background-color: #2a2a2a;
    color: #e5e7eb;
    border: 1px solid rgba(90, 90, 90, 150);
    border-radius: 5px;
    padding: 4px;
    font-size: 13px;
    selection-background-color: #3b82f6;
}
QDialog QPlainTextEdit:read-only {
    background-color: #242424;
}
QDialog QListWidget {
    alternate-background-color: #303030;
    outline: 0;  /* no dotted focus frame around the current item */
}
QDialog QListWidget::item {
    padding: 6px;
}
QDialog QListWidget::item:selected {
    background-color: #3b82f6;
    color: white;
}
QDialog QListWidget::item:hover:!selected {
    background-color: #35363a;
}

/* --- Help: topic text (QTextBrowser) --- */
QDialog QTextBrowser {
    background-color: #242424;
    color: #e5e7eb;
    border: 1px solid rgba(90, 90, 90, 150);
    border-radius: 5px;
    font-size: 13px;
    selection-background-color: #3b82f6;
}

/* --- Scrollbars in dialogs (the light system ones stand out on the dark theme) --- */
QDialog QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QDialog QScrollBar::handle:vertical {
    background: rgba(150, 150, 150, 110);
    border-radius: 3px;
    min-height: 24px;
}
QDialog QScrollBar::handle:vertical:hover {
    background: rgba(170, 170, 170, 170);
}
QDialog QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QDialog QScrollBar::handle:horizontal {
    background: rgba(150, 150, 150, 110);
    border-radius: 3px;
    min-width: 24px;
}
QDialog QScrollBar::add-line:horizontal,
QDialog QScrollBar::sub-line:horizontal,
QDialog QScrollBar::add-page:horizontal,
QDialog QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}
QDialog QScrollBar::add-line:vertical,
QDialog QScrollBar::sub-line:vertical,
QDialog QScrollBar::add-page:vertical,
QDialog QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

/* --- 3.0: secondary dialog button ("Restore defaults") --- */
QDialog QPushButton#secondary_dialog_btn {
    background-color: rgba(75, 85, 99, 200);
}
QDialog QPushButton#secondary_dialog_btn:hover {
    background-color: rgba(107, 114, 128, 230);
}

/* --- 3.0: secondary text (history statistics) --- */
QDialog QLabel#muted_label {
    color: #9ca3af;
    font-size: 12px;
}
